      "targets": [
        {
          "expr": "sum by (state, visibility) (parsec_channels_active)",
          "legendFormat": "{{state}} / {{visibility}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
